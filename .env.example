# Hub login (required to open `/` and `/add-business`). Copy to `.env` and set strong values.
# Note: VITE_* values are used by the client login UI.
VITE_HUB_USERNAME=admin
VITE_HUB_PASSWORD=admin1234

# Server-side hub auth for /api/onboard-business (set in Vercel project env, not exposed to browser).
HUB_USERNAME=admin
HUB_PASSWORD=admin1234

# GitHub write access for onboarding (server-side only).
# Leave GITHUB_TOKEN empty for local dev — files are written directly to the repo folder.
GITHUB_TOKEN=
GITHUB_REPO=owner/privacy-policies
GITHUB_BRANCH=main

# Public site URL shown after successful onboarding.
PUBLIC_SITE_URL=https://privacy-policy.elvatech.in
